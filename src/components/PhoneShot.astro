---
// Captura de móvil vertical (una sola). Muestra la imagen si hay `src`; si no,
// un placeholder con forma de smartphone. Mismo tratamiento de marco que Gallery
// en modo portrait, pero para uso aislado (El problema, En uso…).
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  size?: 'md' | 'lg';
}

const { src, alt, caption, size = 'md' } = Astro.props;
---

<figure class:list={['pshot', size === 'lg' && 'pshot--lg']}>
  {
    src ? (
      <img class="pshot__img" src={src} alt={alt ?? caption ?? ''} loading="lazy" />
    ) : (
      <div class="pshot__ph" role="img" aria-label={`${caption ?? 'Captura'} — captura pendiente`}>
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="2" />
          <path d="M3 17l5-4 4 3 3-2 6 5" />
        </svg>
        <span class="pshot__tag mono">captura pendiente</span>
      </div>
    )
  }
  {caption && <figcaption class="pshot__cap">{caption}</figcaption>}
</figure>

<style>
  .pshot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 300px;
    margin-inline: auto;
  }
  @media (min-width: 860px) {
    .pshot {
      max-width: 380px;
    }
  }
  .pshot--lg {
    max-width: 340px;
  }
  @media (min-width: 860px) {
    .pshot--lg {
      max-width: 430px;
    }
  }
  .pshot__img {
    width: 100%;
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .pshot__ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    aspect-ratio: 9 / 19.5;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--family) 5%, var(--surface));
    color: var(--text-muted);
    box-shadow: var(--shadow);
  }
  .pshot__tag {
    font-size: 0.7rem;
  }
  .pshot__cap {
    font-size: var(--step-0);
    color: var(--text-muted);
    text-align: center;
  }
</style>
