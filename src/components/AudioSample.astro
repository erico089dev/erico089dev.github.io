---
interface Props {
  label: string;
  meta: string;
  /** URL del audio real. Sin ella, se muestra el estado "muestra pendiente". */
  src?: string;
}

const { label, meta, src } = Astro.props;
const pending = !src;
---

<div class:list={['sample', { 'is-pending': pending }]} data-reveal>
  <button
    class="sample__play"
    type="button"
    aria-label={pending ? `${label} — muestra pendiente` : `Reproducir ${label}`}
    disabled={pending}
    data-audio-play
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M8 5v14l11-7z" />
    </svg>
  </button>

  <div class="sample__info">
    <span class="sample__label">{label}</span>
    <span class="sample__meta mono">{meta}</span>
  </div>

  <div class="sample__wave" aria-hidden="true">
    {Array.from({ length: 28 }).map(() => <span class="sample__bar"></span>)}
  </div>

  {pending && <span class="sample__tag mono">pendiente</span>}
  {src && <audio preload="none" src={src}></audio>}
</div>

<script>
  const playIcon = 'M8 5v14l11-7z';
  const pauseIcon = 'M6 5h4v14H6zM14 5h4v14h-4z';

  document.querySelectorAll<HTMLElement>('.sample').forEach((sample) => {
    const btn = sample.querySelector<HTMLButtonElement>('[data-audio-play]');
    const audio = sample.querySelector<HTMLAudioElement>('audio');
    const path = btn?.querySelector('path');
    if (!btn || !audio || !path) return;

    btn.addEventListener('click', () => {
      if (audio.paused) {
        document.querySelectorAll<HTMLAudioElement>('.sample audio').forEach((a) => {
          if (a !== audio) a.pause();
        });
        audio.play();
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', () => path.setAttribute('d', pauseIcon));
    audio.addEventListener('pause', () => path.setAttribute('d', playIcon));
    audio.addEventListener('ended', () => path.setAttribute('d', playIcon));
  });
</script>

<style>
  .sample {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .sample.is-pending {
    border-style: dashed;
  }
  .sample__play {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--r-pill);
    border: 1px solid color-mix(in srgb, var(--family) 40%, transparent);
    background: color-mix(in srgb, var(--family) 14%, transparent);
    color: var(--family);
    cursor: pointer;
    transition: transform 0.15s var(--ease), background-color 0.2s var(--ease);
  }
  .sample__play:hover:not(:disabled) {
    transform: scale(1.06);
    background: color-mix(in srgb, var(--family) 22%, transparent);
  }
  .sample__play:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .sample__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .sample__label {
    font-size: var(--step-0);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sample__meta {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .sample__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    height: 2rem;
    min-width: 0;
    overflow: hidden;
    margin-inline: var(--sp-2);
    opacity: 0.7;
  }
  .sample__bar {
    flex: 1;
    min-width: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--family) 55%, var(--border));
    height: 30%;
  }
  /* Alturas variadas para simular una onda, sin JS. */
  .sample__bar:nth-child(3n) { height: 80%; }
  .sample__bar:nth-child(3n + 1) { height: 45%; }
  .sample__bar:nth-child(4n) { height: 100%; }
  .sample__bar:nth-child(5n) { height: 25%; }
  .sample__bar:nth-child(7n) { height: 65%; }
  .sample__tag {
    font-size: 0.68rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--r-sm);
    color: var(--text-muted);
    background: var(--surface-2);
    border: 1px solid var(--border);
    white-space: nowrap;
  }
</style>
