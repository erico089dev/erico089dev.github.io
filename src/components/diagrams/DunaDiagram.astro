---
// Arquitectura Duna. SVG inline temeable (var(--family) = teal en /es/duna).
---

<svg class="d-svg" viewBox="0 0 920 356" role="presentation" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="duna-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
      <path d="M1 1 L8 4.5 L1 8 Z" class="d-arrowhead" />
    </marker>
    <marker id="duna-arrow-start" markerWidth="9" markerHeight="9" refX="2" refY="4.5" orient="auto">
      <path d="M8 1 L1 4.5 L8 8 Z" class="d-arrowhead" />
    </marker>
  </defs>

  <!-- Límite de red privada Tailscale -->
  <rect class="d-zone" x="22" y="44" width="876" height="292" rx="12" />
  <text class="d-zone-label" x="42" y="34">red privada · Tailscale · sin puertos expuestos</text>

  <!-- Clientes -->
  <text class="d-col" x="50" y="76">3 clientes</text>
  <g>
    <rect class="d-box" x="50" y="90" width="182" height="52" rx="8" />
    <text class="d-title" x="66" y="114">PWA navegador</text>
    <text class="d-sub" x="66" y="132">instalable</text>
  </g>
  <g>
    <rect class="d-box" x="50" y="160" width="182" height="52" rx="8" />
    <text class="d-title" x="66" y="184">PWA iPhone</text>
    <text class="d-sub" x="66" y="202">Web Push en iOS</text>
  </g>
  <g>
    <rect class="d-box" x="50" y="230" width="182" height="52" rx="8" />
    <text class="d-title" x="66" y="254">bot Telegram</text>
    <text class="d-sub" x="66" y="272">texto y voz</text>
  </g>

  <!-- Motor de chat -->
  <rect class="d-core" x="372" y="142" width="176" height="88" rx="10" />
  <text class="d-title" x="460" y="180" text-anchor="middle">Motor de chat</text>
  <text class="d-sub" x="460" y="200" text-anchor="middle">Express · Groq</text>
  <text class="d-sub" x="460" y="216" text-anchor="middle">Whisper (voz)</text>

  <!-- Clientes → motor -->
  <path class="d-flow" d="M232 116 C 300 116, 320 186, 370 186" />
  <path class="d-flow" d="M232 186 L 370 186" />
  <path class="d-flow" d="M232 256 C 300 256, 320 186, 370 186" />

  <!-- Destinos -->
  <g>
    <rect class="d-box" x="700" y="96" width="176" height="80" rx="8" />
    <text class="d-title" x="716" y="122">Google</text>
    <text class="d-sub" x="716" y="142">Calendar + Tasks</text>
    <text class="d-sub" x="716" y="160">fuente de verdad</text>
  </g>
  <g>
    <rect class="d-box" x="700" y="200" width="176" height="80" rx="8" />
    <text class="d-title" x="716" y="226">SQLite</text>
    <text class="d-sub" x="716" y="246">prioridad · push</text>
    <text class="d-sub" x="716" y="264">preferencias · historial</text>
  </g>

  <!-- Motor ↔ Google (sync), Motor → SQLite -->
  <line class="d-flow d-flow--both" x1="548" y1="150" x2="700" y2="136" />
  <line class="d-flow" x1="548" y1="220" x2="700" y2="240" />
</svg>

<style>
  .d-svg {
    display: block;
    width: 100%;
    height: auto;
    min-width: 660px;
  }
  .d-box {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .d-core {
    fill: var(--family-soft);
    stroke: var(--family);
    stroke-width: 1.5;
  }
  .d-zone {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
  }
  .d-zone-label,
  .d-col {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-muted);
  }
  .d-title {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .d-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-muted);
  }
  .d-flow {
    stroke: var(--family);
    stroke-width: 2;
    fill: none;
    marker-end: url(#duna-arrow);
  }
  .d-flow--both {
    marker-start: url(#duna-arrow-start);
  }
  .d-arrowhead {
    fill: var(--family);
  }
</style>
