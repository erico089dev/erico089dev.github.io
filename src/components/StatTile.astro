---
interface Props {
  value: string;
  label: string;
  /** Alterna el color del valor entre el acento primario y el secundario de la paleta. */
  tone?: 'primary' | 'secondary';
}

const { value, label, tone = 'primary' } = Astro.props;
---

<div class="stat" data-tone={tone}>
  <span class="stat__value">{value}</span>
  <span class="stat__label">{label}</span>
</div>

<style>
  .stat {
    --fam: var(--accent);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-4) var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    /* Tinte del color (dorado o azul) desde la esquina → la paleta completa en juego. */
    background:
      radial-gradient(120% 140% at 100% 0%,
        color-mix(in srgb, var(--fam) 12%, transparent), transparent 60%),
      var(--surface);
    transition: transform 0.18s var(--ease), border-color 0.2s var(--ease);
  }
  .stat[data-tone='secondary'] { --fam: var(--accent-2, var(--accent)); }
  .stat:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--fam) 45%, var(--border));
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    /* Mezcla con el texto → el azul (secundario) se lee bien tanto en claro como en
       oscuro, sin dejar de ser azul; el dorado apenas cambia. */
    color: color-mix(in srgb, var(--fam) 74%, var(--text));
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
