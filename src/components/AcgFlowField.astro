---
// Fondo ambiental propio de ACG (identidad "contenido generándose"): CSS+SVG puro, sin JS.
// Motivos seleccionables por prop `motif` para comparar en el lab:
//   - 'streams'         : corrientes de contenido que fluyen en diagonal (dashoffset animado).
//   - 'nodes'           : grafo tipo pipeline/DAG con nodos que laten y aristas que se recorren.
//   - 'aurora'          : manchas violeta difuminadas a la deriva (lo más sutil).
//   - 'platforms'       : streams + glyphs de YouTube/Instagram/TikTok flotando (monocromo violeta).
//   - 'platforms-brand' : igual pero con el color de marca de cada plataforma (toque de color).
// Todo se colorea desde --family/--acg, así que se retema solo con el tema y el data-family.
interface Props {
  motif?: 'streams' | 'nodes' | 'aurora' | 'platforms' | 'platforms-brand';
}
const { motif = 'streams' } = Astro.props;

const isPlatforms = motif === 'platforms' || motif === 'platforms-brand';

// Glyphs de plataforma (inline, currentColor). El "vídeo" de ACG termina en estas.
const PLAT_ICON = {
  youtube: '<rect x="1.5" y="4.5" width="21" height="15" rx="4.6" fill="currentColor"/><path d="M10 8.4 L16 12 L10 15.6 Z" fill="var(--bg)"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5.2" fill="none" stroke="currentColor" stroke-width="1.9"/><circle cx="12" cy="12" r="4.3" fill="none" stroke="currentColor" stroke-width="1.9"/><circle cx="17.2" cy="6.8" r="1.25" fill="currentColor"/>',
  tiktok: '<path d="M13.2 3 h2.9 c0.4 2.5 2 4.2 4.4 4.5 v3 c-1.7 0.05 -3.2 -0.45 -4.4 -1.3 v6.1 a5.6 5.6 0 1 1 -5.6 -5.6 c0.33 0 0.66 0.03 0.98 0.08 v3.1 a2.55 2.55 0 1 0 1.72 2.4 z" fill="currentColor"/>',
} as const;

// Colocación de los glyphs flotantes (left/top en %, tamaño en px, ritmo por --i).
const PLATS = [
  { p: 'youtube',   left: 16, top: 24, size: 46, i: 0 },
  { p: 'instagram', left: 78, top: 18, size: 40, i: 1 },
  { p: 'tiktok',    left: 60, top: 60, size: 34, i: 2 },
  { p: 'instagram', left: 34, top: 68, size: 30, i: 3 },
  { p: 'youtube',   left: 90, top: 54, size: 30, i: 4 },
  { p: 'tiktok',    left: 6,  top: 52, size: 26, i: 5 },
] as const;
---

<div class:list={['aff', `aff--${motif}`, isPlatforms && 'aff--has-plats']} aria-hidden="true">
  {motif === 'streams' && (
    <svg class="aff__svg" viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="aff-stroke" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="var(--family)" stop-opacity="0" />
          <stop offset="0.5" stop-color="var(--family)" stop-opacity="1" />
          <stop offset="1" stop-color="var(--family)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <g class="aff__streams">
        <path class="aff__stream" style="--i:0" d="M-100 120 C 250 60, 520 220, 820 150 C 1040 100, 1200 190, 1360 140" />
        <path class="aff__stream" style="--i:1" d="M-100 210 C 220 160, 540 300, 840 240 C 1060 195, 1220 280, 1360 235" />
        <path class="aff__stream" style="--i:2" d="M-100 300 C 260 250, 520 380, 820 330 C 1050 290, 1210 360, 1360 320" />
        <path class="aff__stream" style="--i:3" d="M-100 385 C 240 345, 520 450, 840 405 C 1060 370, 1220 430, 1360 400" />
        <path class="aff__stream" style="--i:4" d="M-100 460 C 260 430, 520 510, 820 475 C 1050 445, 1210 495, 1360 470" />
      </g>
      <g class="aff__spark">
        <circle style="--i:0" r="3.5" cx="380" cy="150" />
        <circle style="--i:1" r="3" cx="720" cy="255" />
        <circle style="--i:2" r="3.5" cx="520" cy="345" />
        <circle style="--i:3" r="3" cx="900" cy="410" />
      </g>
    </svg>
  )}

  {motif === 'nodes' && (
    <svg class="aff__svg" viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <g class="aff__edges">
        <path class="aff__edge" style="--i:0" d="M160 120 L 420 90" />
        <path class="aff__edge" style="--i:1" d="M420 90 L 640 200" />
        <path class="aff__edge" style="--i:2" d="M160 300 L 420 90" />
        <path class="aff__edge" style="--i:3" d="M640 200 L 900 140" />
        <path class="aff__edge" style="--i:4" d="M640 200 L 880 340" />
        <path class="aff__edge" style="--i:5" d="M420 380 L 640 200" />
        <path class="aff__edge" style="--i:6" d="M900 140 L 1080 260" />
        <path class="aff__edge" style="--i:7" d="M880 340 L 1080 260" />
      </g>
      <g class="aff__nodes">
        <circle style="--i:0" cx="160" cy="120" r="7" />
        <circle style="--i:1" cx="420" cy="90" r="9" />
        <circle style="--i:2" cx="160" cy="300" r="6" />
        <circle style="--i:3" cx="420" cy="380" r="7" />
        <circle style="--i:4" cx="640" cy="200" r="11" />
        <circle style="--i:5" cx="900" cy="140" r="8" />
        <circle style="--i:6" cx="880" cy="340" r="8" />
        <circle style="--i:7" cx="1080" cy="260" r="10" />
      </g>
    </svg>
  )}

  {(motif === 'aurora' || isPlatforms) && (
    <div class="aff__aurora">
      <span class="aff__blob aff__blob--1"></span>
      <span class="aff__blob aff__blob--2"></span>
      <span class="aff__blob aff__blob--3"></span>
    </div>
  )}

  {isPlatforms && (
    <div class:list={['aff__plats', motif === 'platforms-brand' && 'aff__plats--brand']}>
      {PLATS.map((g) => (
        <span
          class:list={['aff__plat', `aff__plat--${g.p}`]}
          style={`left:${g.left}%; top:${g.top}%; --sz:${g.size}px; --i:${g.i}`}
        >
          <svg viewBox="0 0 24 24" width={g.size} height={g.size} set:html={PLAT_ICON[g.p]} />
        </span>
      ))}
    </div>
  )}

  <div class="aff__scrim"></div>
</div>

<style>
  .aff {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .aff__svg {
    position: absolute;
    inset: -6% -8%;
    width: 116%;
    height: 112%;
    display: block;
  }
  .aff__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom,
        color-mix(in srgb, var(--bg) 6%, transparent) 0%,
        color-mix(in srgb, var(--bg) 24%, transparent) 60%,
        var(--surface) 100%);
  }

  /* ---- streams ---- */
  .aff__stream {
    fill: none;
    stroke: url(#aff-stroke);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 120 340;
    opacity: 0.55;
    animation: aff-flow 9s linear infinite;
    animation-delay: calc(var(--i) * -1.5s);
  }
  .aff--streams { opacity: 0.9; }
  .aff__spark circle {
    fill: var(--family);
    opacity: 0;
    animation: aff-spark 4.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.1s);
  }
  @keyframes aff-flow {
    to { stroke-dashoffset: -460; }
  }
  @keyframes aff-spark {
    0%, 100% { opacity: 0; transform: scale(0.6); }
    50% { opacity: 0.9; transform: scale(1); }
  }

  /* ---- nodes ---- */
  .aff--nodes { opacity: 0.85; }
  .aff__edge {
    fill: none;
    stroke: var(--family);
    stroke-width: 1.4;
    stroke-dasharray: 40 260;
    opacity: 0.35;
    animation: aff-edge 6s linear infinite;
    animation-delay: calc(var(--i) * -0.7s);
  }
  .aff__nodes circle {
    fill: color-mix(in srgb, var(--family) 78%, var(--surface));
    stroke: var(--family);
    stroke-width: 1.5;
    animation: aff-pulse 4s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.5s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes aff-edge {
    to { stroke-dashoffset: -300; }
  }
  @keyframes aff-pulse {
    0%, 100% { opacity: 0.45; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.12); }
  }

  /* ---- aurora ---- */
  .aff__aurora { position: absolute; inset: 0; filter: blur(46px); }
  .aff__blob {
    position: absolute;
    display: block;
    border-radius: 50%;
    opacity: 0.5;
    background: radial-gradient(circle at 50% 50%, var(--family), transparent 68%);
    animation: aff-drift 16s ease-in-out infinite;
  }
  .aff__blob--1 { width: 46%; height: 70%; left: 58%; top: -22%; }
  .aff__blob--2 { width: 40%; height: 60%; left: -10%; top: 8%; opacity: 0.4; animation-delay: -5s; }
  .aff__blob--3 { width: 34%; height: 52%; left: 30%; top: 30%; opacity: 0.3; animation-delay: -9s; }
  @keyframes aff-drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-6%, 5%) scale(1.1); }
  }

  /* ---- platforms (iconos flotando sobre aurora suave, sin líneas) ---- */
  .aff--has-plats { opacity: 1; }
  .aff--has-plats .aff__aurora { opacity: 0.85; }
  .aff__plats { position: absolute; inset: 0; }
  .aff__plat {
    position: absolute;
    display: grid;
    place-items: center;
    width: var(--sz);
    height: var(--sz);
    transform: translate(-50%, -50%);
    color: var(--family);
    opacity: 0.5;
    animation: aff-float 11s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.6s);
    filter: drop-shadow(0 6px 16px color-mix(in srgb, var(--family) 30%, transparent));
  }
  .aff__plat svg { display: block; width: 100%; height: 100%; }
  /* toque de color de marca (solo en la variante 'platforms-brand') */
  .aff__plats--brand .aff__plat--youtube { color: #ff0033; opacity: 0.62; }
  .aff__plats--brand .aff__plat--instagram { color: #e1306c; opacity: 0.6; }
  .aff__plats--brand .aff__plat--tiktok { color: #25f4ee; opacity: 0.58; }
  .aff__plats--brand .aff__plat--youtube { filter: drop-shadow(0 6px 16px rgba(255,0,51,0.3)); }
  .aff__plats--brand .aff__plat--instagram { filter: drop-shadow(0 6px 16px rgba(225,48,108,0.3)); }
  .aff__plats--brand .aff__plat--tiktok { filter: drop-shadow(0 6px 16px rgba(37,244,238,0.28)); }
  @keyframes aff-float {
    0%, 100% { transform: translate(-50%, calc(-50% + 8px)); opacity: 0.35; }
    50% { transform: translate(-50%, calc(-50% - 8px)); opacity: 0.62; }
  }

  @media (prefers-reduced-motion: reduce) {
    .aff__stream, .aff__spark circle, .aff__edge, .aff__nodes circle, .aff__blob, .aff__plat {
      animation: none;
    }
    .aff__spark circle { opacity: 0.6; }
    .aff__plat { opacity: 0.5; transform: translate(-50%, -50%); }
  }
</style>
