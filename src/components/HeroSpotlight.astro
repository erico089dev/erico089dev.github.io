---
// Mini-carrusel de proyectos (lado derecho del hero). Carrusel horizontal LIMPIO: los
// proyectos entran/salen deslizando de lado (sin superponerse), con una pausa en cada
// uno. Cada slide: mini-esquema de la app (ProjectThumb) + nombre + qué hace, en SU
// color de familia. CSS puro, sin JS. Se clona el primer proyecto al final para que el
// bucle sea continuo (el reset cae en el mismo fotograma).
import { type Locale, useRawTranslations } from '../i18n/utils';
import ProjectThumb from './ProjectThumb.astro';

interface Props {
  locale?: Locale;
  label?: string;
}
const { locale = 'es', label = 'Proyectos' } = Astro.props;
const tRaw = useRawTranslations(locale);

interface Project {
  family: 'acg' | 'duna' | 'inbox';
  icon?: string;
  name: string;
  full: string;
  tagline: string;
  href: string;
}
const projects = tRaw<Project[]>('projects.items', []);
const count = projects.length || 1;
// Clon del primero al final → bucle sin salto.
const slides = projects.length ? [...projects, projects[0]] : [];

// Keyframes generados según el nº real de proyectos (antes estaban hardcodeados a 4 y
// al pasar a 3 el carrusel se paraba a media diapositiva). Hay `count + 1` posiciones
// (proyectos + clon del primero); cada una ocupa `100/(count+1)%` del track y del
// tiempo. En cada posición hay una pausa (0.8 del segmento) y luego desliza al siguiente.
const segs = count + 1;
const seg = 100 / segs;
const round = (n: number) => Number(n.toFixed(3));
let carouselSteps = '';
for (let k = 0; k <= count; k++) {
  const start = round(k * seg);
  const end = k === count ? 100 : round(k * seg + seg * 0.8);
  const tx = round(-k * seg);
  carouselSteps += `${start}%, ${end}% { transform: translateX(${tx}%); } `;
}
const carouselKeyframes = `@keyframes spot-carousel-dyn { ${carouselSteps}}`;
---

<style is:global set:html={carouselKeyframes}></style>

<div class="spot">
  <span class="spot__label mono">
    <span class="spot__live"></span>
    {label}
  </span>
  <div class="spot__stage">
    <div class="spot__track">
      {
        slides.map((p, i) => (
          <a
            class="spot__item"
            href={p.href}
            data-tone={i % 2 === 0 ? 'primary' : 'secondary'}
          >
            <ProjectThumb family={p.family} />
            <div class="spot__meta">
              <div class="spot__row">
                {p.icon && (
                  <img class="spot__ico" src={p.icon} alt="" width="28" height="28" decoding="async" />
                )}
                <span class="spot__name">{p.name}</span>
                <span class="spot__full mono">{p.full}</span>
              </div>
              <p class="spot__tag">{p.tagline}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style define:vars={{ count }}>
  /* Integrado en el hero (sin caja tipo pop-up): sin borde/sombra/fondo propios. */
  .spot {
    width: min(100%, 22rem);
  }
  /* Etiqueta como pequeña píldora con el color secundario de la paleta (azul polvo /
     sage), para que ese color aparezca en la UI. */
  /* Píldora RELLENA con el color secundario (azul polvo) → el azul se ve de verdad. */
  .spot__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-2-ink, var(--accent-ink));
    background: var(--accent-2, var(--accent));
    padding: 0.3rem 0.75rem;
    border-radius: var(--r-pill);
  }
  .spot__live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent-2-ink, var(--accent-ink));
    opacity: 0.8;
    animation: spot-pulse 2.4s ease-out infinite;
  }
  .spot__stage {
    position: relative;
    height: 16rem;
    margin-top: 0.9rem;
    overflow: hidden;
  }
  .spot__track {
    display: flex;
    height: 100%;
    width: calc((var(--count) + 1) * 100%);
    animation: spot-carousel-dyn calc((var(--count) + 1) * 4s) cubic-bezier(0.7, 0, 0.2, 1) infinite;
  }
  .spot__item {
    flex: 0 0 calc(100% / (var(--count) + 1));
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-right: 0.15rem;
    text-decoration: none;
    color: inherit;
    --fam: var(--accent);
    transition: transform 0.18s var(--ease);
  }
  /* Color de paleta (alterna dorado/azul), igual que las cartitas de proyecto. */
  .spot__item[data-tone='secondary'] { --fam: var(--accent-2, var(--accent)); }
  .spot__item:hover :global(.thumb) {
    border-color: color-mix(in srgb, var(--fam) 55%, var(--border));
  }
  .spot__item:hover .spot__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .spot__meta { display: flex; flex-direction: column; gap: 0.25rem; }
  .spot__row { display: flex; align-items: baseline; gap: 0.5rem; }
  /* Icono real de la app (si existe): cuadradito redondeado junto al nombre. */
  .spot__ico {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 7px;
    object-fit: cover;
    flex: none;
    align-self: center;
    border: 1px solid color-mix(in srgb, var(--fam) 40%, var(--border));
  }
  .spot__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--fam);
  }
  .spot__full { font-size: 0.76rem; color: var(--text-muted); }
  .spot__tag {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
    opacity: 0.82;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Los keyframes del carrusel (`spot-carousel-dyn`) se generan en el frontmatter según
     el nº real de proyectos (ver arriba) → siempre cuadran, sean 3, 4 o los que haya. */
  @keyframes spot-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-2, var(--accent)) 55%, transparent); }
    70% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .spot__track { animation: none; transform: translateX(0); }
    .spot__live { animation: none; }
  }
</style>
