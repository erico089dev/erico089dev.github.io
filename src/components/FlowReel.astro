---
// "Mini-vídeo" de un flujo de ACG: escenas ilustradas (SVG inline) que se cruzan en
// bucle dentro de un marco de móvil — mismo truco crossfade que PhoneCarousel/DunaDuneField,
// cero JS. Cuenta el viaje del flujo (aquí: Reddit Video) para que se VEA, no solo se lea.
// Los frames reales del vídeo se podrán sustituir aquí más adelante (slot de imagen por escena).
interface Props {
  flowName?: string;
  automation?: 'auto' | 'semi';
  sec?: number; // segundos por escena
  scene?: number; // si se da, renderiza SOLO esa escena estática (para posters/capturas)
  frames?: (string | null | undefined)[]; // frame REAL por escena (imagen); si falta, cae a la ilustración SVG
  head?: boolean; // muestra la cabecera (nombre + badge); false para tiras de varias escenas
  caption?: boolean; // muestra el pie de foto por escena; false si lo gestiona el contenedor
}
const { flowName = 'Reddit Video', automation = 'auto', sec = 3.2, scene, frames, head = true, caption = true } = Astro.props;

