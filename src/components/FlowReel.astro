const single = typeof scene === 'number';
const shown = single ? [SCENES[scene]] : SCENES;
---

<figure class:list={['reel', single && 'reel--static']} style={`--count:${SCENES.length}; --sec:${sec}`}>
  {head && (
    <figcaption class="reel__head">
      <span class="reel__name">{flowName}</span>
      <span class:list={['reel__badge', `reel__badge--${automation}`]}>
        {automation === 'auto' ? 'Automático' : 'Semiautomático'}
      </span>
    </figcaption>
  )}

  <div class="reel__phone">
    <span class="reel__notch"></span>
    {
      shown.map((s, i) => {
        const realIdx = single ? (scene as number) : i;
        const img = frames?.[realIdx];
        return (
          <div class="reel__slide" style={`--i:${single ? 0 : i}`}>
            {img ? (
              <img class="scene scene--real" src={img} alt={s.cap} loading="lazy" />
            ) : (
              <svg viewBox="0 0 300 650" class="scene" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" set:html={s.svg} />
            )}
          </div>
        );
      })
    }
  </div>

  {!single && (
    <div class="reel__dots">
      {SCENES.map((_, i) => <span class="reel__dot" style={`--i:${i}`}></span>)}
    </div>
  )}
  {caption && (
    <div class="reel__caps">
      {shown.map((s, i) => <span class="reel__cap" style={`--i:${single ? 0 : i}`}>{s.cap}</span>)}
    </div>
  )}
</figure>

<style>
  .reel {
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .reel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .reel__name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; }
  .reel__badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--r-pill);
    border: 1px solid transparent;
  }
  .reel__badge--auto {
    color: var(--ok);
    background: color-mix(in srgb, var(--ok) 14%, transparent);
    border-color: color-mix(in srgb, var(--ok) 30%, transparent);
  }
  .reel__badge--semi {
    color: var(--family);
    background: var(--family-soft);
    border-color: color-mix(in srgb, var(--family) 30%, transparent);
  }

  .reel__phone {
    position: relative;
    aspect-ratio: 9 / 19.5;
    border-radius: 26px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
    background: var(--bg);
  }
  .reel__notch {
    position: absolute;
    top: 8px; left: 50%;
    transform: translateX(-50%);
    width: 34%; height: 6px;
    border-radius: 999px;
    background: var(--border-strong);
    opacity: 0.5; z-index: 3;
  }
  .reel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: reel-fade calc(var(--count) * var(--sec) * 1s) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--sec) * -1s);
  }
  .reel__slide:first-child { opacity: 1; }
  .reel--static .reel__slide { animation: none; opacity: 1; }
  .scene { display: block; width: 100%; height: 100%; }
  .scene--real { object-fit: cover; }

  @keyframes reel-fade {
    0% { opacity: 0; }
    5% { opacity: 1; }
    18% { opacity: 1; }
    23% { opacity: 0; }
    100% { opacity: 0; }
  }

  .reel__dots { display: flex; justify-content: center; gap: var(--sp-2); }
  .reel__dot {
    width: 20px; height: 4px;
    border-radius: 999px;
    background: var(--border-strong);
    opacity: 0.4;
    position: relative;
    overflow: hidden;
  }
  .reel__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--family);
    opacity: 0;
    animation: reel-fade calc(var(--count) * var(--sec) * 1s) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--sec) * -1s);
  }
  .reel__dot:first-child::after { opacity: 1; }

  .reel__caps { position: relative; min-height: 3em; }
  .reel__cap {
    position: absolute;
    inset: 0;
    text-align: center;
    font-size: var(--step-0);
    color: var(--text-muted);
    line-height: 1.4;
    opacity: 0;
    animation: reel-fade calc(var(--count) * var(--sec) * 1s) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--sec) * -1s);
  }
  .reel__cap:first-child { opacity: 1; }
  .reel--static .reel__cap { animation: none; opacity: 1; position: static; }

  @media (prefers-reduced-motion: reduce) {
    .reel__slide, .reel__cap, .reel__dot::after { animation: none; opacity: 0; }
    .reel__slide:first-child, .reel__cap:first-child, .reel__dot:first-child::after { opacity: 1; }
  }
</style>
