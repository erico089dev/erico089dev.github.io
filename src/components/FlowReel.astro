          <text x="80" y="27" fill="var(--text)">Instagram</text><text x="80" y="45" font-family="var(--font-mono)" font-weight="400" font-size="10" fill="var(--text-muted)">Reel · @erico089dev</text>
          <rect x="196" y="17" width="68" height="24" rx="12" fill="var(--ok)" opacity="0.16" /><path d="M208 29 l4 4 l8 -9" fill="none" stroke="var(--ok)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /><text x="228" y="33" font-family="var(--font-mono)" font-weight="400" font-size="10" fill="var(--ok)">listo</text>
