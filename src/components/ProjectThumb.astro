---
// Mini-esquema (mockup falso) de cada app, para el mini-rotador del hero. SVG inline,
// coloreado con var(--fam) (el color del proyecto). Son representaciones abstractas
// tipo "wireframe", pensadas como placeholder hasta tener capturas reales.
interface Props {
  family: 'acg' | 'duna' | 'inbox';
}
const { family } = Astro.props;
---

<div class="thumb" data-family={family}>
  {family === 'acg' && (
    <svg viewBox="0 0 240 120" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Esquema ACG">
      <rect x="14" y="16" width="70" height="88" rx="12" class="t-stroke" />
      <circle cx="49" cy="60" r="17" class="t-soft" />
      <polygon points="44,51 44,69 62,60" class="t-fill" />
      <path d="M96 60 h26" class="t-stroke" />
      <path d="M118 53 l9 7 -9 7" class="t-stroke" />
      <rect x="150" y="22" width="72" height="20" rx="6" class="t-line" />
      <rect x="150" y="50" width="72" height="20" rx="6" class="t-line" />
      <rect x="150" y="78" width="72" height="20" rx="6" class="t-fillsoft" />
    </svg>
  )}
  {family === 'duna' && (
    <svg viewBox="0 0 240 120" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Esquema Duna">
      <rect x="92" y="10" width="56" height="100" rx="12" class="t-stroke" />
      <rect x="104" y="22" width="32" height="20" rx="4" class="t-fillsoft" />
      <path d="M108 32 h24 M108 26 v12 M120 26 v12" class="t-stroke-thin" />
      <circle cx="112" cy="60" r="5" class="t-fill" />
      <path d="M124 60 h14" class="t-stroke-thin" />
      <rect x="104" y="78" width="32" height="16" rx="8" class="t-soft" />
      <path d="M110 86 h20" class="t-stroke-thin" />
    </svg>
  )}
  {family === 'inbox' && (
    <svg viewBox="0 0 240 120" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Esquema Inbox">
      <rect x="20" y="34" width="26" height="40" rx="13" class="t-fillsoft" />
      <path d="M33 78 v10 M25 88 h16" class="t-stroke" />
      <path d="M33 46 v18" class="t-stroke" />
      <path d="M60 60 h26" class="t-stroke" />
      <path d="M82 53 l9 7 -9 7" class="t-stroke" />
      <rect x="104" y="26" width="118" height="68" rx="10" class="t-stroke" />
      <path d="M118 44 h72 M118 60 h90 M118 76 h50" class="t-stroke-thin" />
      <circle cx="200" cy="44" r="7" class="t-fill" />
    </svg>
  )}
</div>

<style>
  .thumb {
    width: 100%;
    aspect-ratio: 240 / 120;
    border-radius: var(--r-md);
    /* Fondo con el color intermedio de la paleta (arena/sage) + un toque del color
       del proyecto → así aparecen más colores de la paleta, no solo el acento. */
    background: color-mix(in srgb, var(--fam) 8%, var(--tint, var(--surface-2)));
    border: 1px solid color-mix(in srgb, var(--fam) 22%, var(--border));
    overflow: hidden;
  }
  .thumb svg { width: 100%; height: 100%; display: block; }
  .t-stroke { fill: none; stroke: var(--fam); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .t-stroke-thin { fill: none; stroke: var(--fam); stroke-width: 2; opacity: 0.7; stroke-linecap: round; }
  .t-fill { fill: var(--fam); }
  .t-soft { fill: color-mix(in srgb, var(--fam) 22%, transparent); }
  .t-fillsoft { fill: color-mix(in srgb, var(--fam) 30%, transparent); }
  .t-soft-dot { fill: color-mix(in srgb, var(--fam) 45%, transparent); }
  .t-line { fill: color-mix(in srgb, var(--fam) 14%, transparent); }
</style>
