---
import StatTile from './StatTile.astro';

interface Stat {
  value: string;
  label: string;
  tone?: 'primary' | 'secondary';
}
interface Props {
  items: Stat[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="statrow container" data-reveal>
    {items.map((s) => <StatTile value={s.value} label={s.label} tone={s.tone} />)}
  </div>
)}

<style>
  .statrow {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
    margin-block: var(--sp-6);
  }
  @media (min-width: 720px) {
    .statrow {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
