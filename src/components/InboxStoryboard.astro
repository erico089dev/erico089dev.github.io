---
// Historieta de inbox: tira de 4 viñetas tipo cómic que cuenta el flujo real —
// veo un bug → lo dicto en un audio → se guarda como ticket en la nube → en casa
// Claude los recupera y los resuelve uno a uno. Los textos vienen de i18n; las
// escenas (SVG) están aquí, indexadas por posición. Temeable por var(--family).
interface Panel {
  title: string;
  sub: string;
}
interface Props {
  panels: Panel[];
}
const { panels } = Astro.props;

// Una escena por viñeta (viewBox 0 0 220 190). Se emparejan por índice con los
// paneles de i18n; si hubiera más textos que escenas, sobran textos sin dibujo.
const SCENES: string[] = [
  // 1 · Uso mi app y veo un bug
  `<svg viewBox="0 0 220 190" class="ib-scn" role="img" aria-hidden="true">
    <use href="#ib-person" x="6" y="70" width="70" height="118"/>
    <rect x="96" y="34" width="80" height="132" rx="14" class="ib-fill" stroke-width="2.5"/>
    <rect x="106" y="48" width="60" height="104" rx="6" class="ib-screen"/>
    <use href="#ib-bug" x="116" y="72" width="40" height="40"/>
    <text x="136" y="140" text-anchor="middle" class="ib-mono ib-warn">error</text>
    <path class="ib-burst" d="M186 46 l6 -12 3 11 11 -4 -7 10 10 5 -12 1 2 12 -8 -9 -9 7 3 -12 -9 6 z"/>
  </svg>`,
  // 2 · Lo dicto en un audio
  `<svg viewBox="0 0 220 190" class="ib-scn" role="img" aria-hidden="true">
    <use href="#ib-person" x="6" y="74" width="70" height="116"/>
    <rect x="96" y="42" width="80" height="128" rx="14" class="ib-fill" stroke-width="2.5"/>
    <rect x="106" y="56" width="60" height="100" rx="6" class="ib-screen"/>
    <use href="#ib-mic" x="120" y="72" width="32" height="32"/>
    <g class="ib-wave">
      <rect x="112" y="120" width="4" height="10" rx="2"/><rect x="120" y="114" width="4" height="22" rx="2"/>
      <rect x="128" y="108" width="4" height="34" rx="2"/><rect x="136" y="116" width="4" height="18" rx="2"/>
      <rect x="144" y="110" width="4" height="30" rx="2"/><rect x="152" y="118" width="4" height="14" rx="2"/>
    </g>
    <g class="ib-bubble"><path d="M40 30 h74 a8 8 0 0 1 8 8 v20 a8 8 0 0 1 -8 8 h-52 l-12 10 2 -10 h-12 a8 8 0 0 1 -8 -8 v-20 a8 8 0 0 1 8 -8 z"/></g>
    <text x="77" y="52" text-anchor="middle" class="ib-mono ib-bubbletx">"el bot&#243;n no va"</text>
  </svg>`,
  // 3 · Se guarda como ticket en la nube
  `<svg viewBox="0 0 220 190" class="ib-scn" role="img" aria-hidden="true">
    <use href="#ib-phone" x="14" y="112" width="42" height="70"/>
    <use href="#ib-cloud" x="70" y="34" width="132" height="86"/>
    <rect x="104" y="60" width="64" height="42" rx="6" class="ib-fill" stroke-width="2"/>
    <line x1="112" y1="74" x2="150" y2="74" class="ib-hardline"/><line x1="112" y1="84" x2="160" y2="84" class="ib-hardline"/>
    <circle cx="136" cy="60" r="3" class="ib-dot"/>
    <path d="M56 138 C 78 138, 84 112, 100 106" class="ib-arrow" marker-end="url(#ib-arrow)"/>
    <text x="136" y="150" text-anchor="middle" class="ib-mono ib-muted">ticket &#183; nube</text>
  </svg>`,
  // 4 · En casa, Claude los resuelve uno a uno
  `<svg viewBox="0 0 220 190" class="ib-scn" role="img" aria-hidden="true">
    <use href="#ib-person" x="150" y="80" width="64" height="110"/>
    <rect x="20" y="40" width="120" height="86" rx="9" class="ib-fill" stroke-width="2.5"/>
    <rect x="30" y="50" width="100" height="66" rx="4" class="ib-screen"/>
    <rect x="64" y="126" width="32" height="10" class="ib-fill" stroke-width="2"/>
    <rect x="50" y="136" width="60" height="6" rx="3" class="ib-fill" stroke-width="2"/>
    <g class="ib-done"><rect x="40" y="60" width="80" height="13" rx="3"/><path d="M45 66.5 l3 3 6 -6" class="ib-check"/></g>
    <g class="ib-done"><rect x="40" y="78" width="80" height="13" rx="3"/><path d="M45 84.5 l3 3 6 -6" class="ib-check"/></g>
    <g class="ib-now"><rect x="40" y="96" width="80" height="13" rx="3"/><circle cx="49" cy="102.5" r="3" class="ib-spin"/></g>
    <use href="#ib-spark" x="150" y="52" width="26" height="26"/>
  </svg>`,
];
---

<!-- Símbolos reutilizables (se declaran una vez) -->
<svg width="0" height="0" class="ib-defs" aria-hidden="true">
  <defs>
    <marker id="ib-arrow" markerWidth="9" markerHeight="9" refX="6" refY="4.5" orient="auto">
      <path d="M1 1 L8 4.5 L1 8 Z" fill="var(--family)"></path>
    </marker>
    <symbol id="ib-person" viewBox="0 0 60 100">
      <circle cx="30" cy="18" r="13" class="ib-fill" stroke-width="2.5"></circle>
      <path d="M6 100 C6 60 10 44 30 44 C50 44 54 60 54 100 Z" class="ib-fill" stroke-width="2.5"></path>
    </symbol>
    <symbol id="ib-phone" viewBox="0 0 40 66">
      <rect x="2" y="2" width="36" height="62" rx="8" class="ib-fill" stroke-width="2.5"></rect>
      <rect x="8" y="10" width="24" height="42" rx="3" class="ib-screen"></rect>
      <circle cx="20" cy="58" r="2.5" class="ib-softdot"></circle>
    </symbol>
    <symbol id="ib-cloud" viewBox="0 0 132 86">
      <path d="M34 78 a24 24 0 0 1 -4 -47 a30 30 0 0 1 58 -6 a22 22 0 0 1 12 41 a2 2 0 0 1 -1 12 Z" class="ib-cloud" stroke-width="2.5"></path>
    </symbol>
    <symbol id="ib-bug" viewBox="0 0 40 40">
      <ellipse cx="20" cy="23" rx="11" ry="13" fill="#e5484d"></ellipse>
      <circle cx="20" cy="12" r="7" fill="#e5484d"></circle>
      <path d="M9 18 L2 14 M9 24 L1 24 M9 30 L3 34 M31 18 L38 14 M31 24 L39 24 M31 30 L37 34" stroke="#e5484d" stroke-width="2.5" stroke-linecap="round"></path>
      <path d="M15 8 L11 3 M25 8 L29 3" stroke="#e5484d" stroke-width="2.5" stroke-linecap="round"></path>
      <line x1="20" y1="14" x2="20" y2="34" stroke="#fff" stroke-width="1.6" opacity="0.7"></line>
    </symbol>
    <symbol id="ib-mic" viewBox="0 0 32 32">
      <rect x="11" y="3" width="10" height="17" rx="5" fill="var(--family)"></rect>
      <path d="M6 15 a10 10 0 0 0 20 0 M16 25 v5" stroke="var(--family)" stroke-width="2.4" fill="none" stroke-linecap="round"></path>
    </symbol>
    <symbol id="ib-spark" viewBox="0 0 26 26">
      <path d="M13 1 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3 z" fill="var(--accent-2)"></path>
    </symbol>
  </defs>
</svg>

<ol class="ibstrip">
  {panels.map((p, i) => (
    <li class="ibpanel">
      <span class="ibpanel__n mono">{String(i + 1).padStart(2, '0')}</span>
      <div class="ibpanel__art" set:html={SCENES[i] ?? ''} />
      <div class="ibpanel__cap">
        <strong class="ibpanel__t">{p.title}</strong>
        <span class="ibpanel__s">{p.sub}</span>
      </div>
    </li>
  ))}
</ol>

<style>
  .ib-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  .ibstrip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 900px) { .ibstrip { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .ibstrip { grid-template-columns: 1fr; } }

  .ibpanel {
    position: relative;
    padding: var(--sp-4);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--r-lg);
    background: var(--bg);
    box-shadow: 5px 5px 0 var(--family-soft);
  }
  .ibpanel__n {
    position: absolute;
    top: 0;
    left: var(--sp-4);
    transform: translateY(-50%);
    background: var(--family);
    color: var(--accent-ink);
    font-size: var(--step--1);
    padding: 0.1rem 0.55rem;
    border-radius: var(--r-pill);
    letter-spacing: 0.02em;
  }
  .ibpanel__art :global(.ib-scn) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ibpanel__cap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: var(--sp-3);
  }
  .ibpanel__t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.2;
    color: var(--text);
  }
  .ibpanel__s {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Piezas de las escenas SVG (globales porque van con set:html) */
  .ibpanel__art :global(.ib-fill) { fill: var(--surface); stroke: var(--text); }
  .ibpanel__art :global(.ib-screen) { fill: var(--family-soft); }
  .ibpanel__art :global(.ib-cloud) { fill: color-mix(in srgb, var(--family) 8%, var(--surface)); stroke: var(--family); }
  .ibpanel__art :global(.ib-softdot) { fill: var(--border-strong); }
  .ibpanel__art :global(.ib-hardline) { stroke: var(--border-strong); stroke-width: 2.5; stroke-linecap: round; }
  .ibpanel__art :global(.ib-dot) { fill: var(--accent-2); }
  .ibpanel__art :global(.ib-arrow) { stroke: var(--family); stroke-width: 2.5; fill: none; stroke-linecap: round; }
  .ibpanel__art :global(.ib-mono) { font-family: var(--font-mono); font-size: 11px; }
  .ibpanel__art :global(.ib-muted) { fill: var(--text-muted); }
  .ibpanel__art :global(.ib-warn) { fill: #e5484d; font-weight: 600; }
  .ibpanel__art :global(.ib-wave rect) { fill: var(--family); }
  .ibpanel__art :global(.ib-burst) { fill: var(--accent-2); }
  .ibpanel__art :global(.ib-bubble path) { fill: var(--surface); stroke: var(--border-strong); stroke-width: 2; }
  .ibpanel__art :global(.ib-bubbletx) { fill: var(--text); font-size: 10px; }
  .ibpanel__art :global(.ib-done rect) { fill: color-mix(in srgb, var(--family) 14%, var(--surface)); }
  .ibpanel__art :global(.ib-now rect) { fill: color-mix(in srgb, var(--accent-2) 20%, var(--surface)); }
  .ibpanel__art :global(.ib-check) { stroke: var(--family); stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ibpanel__art :global(.ib-spin) { fill: none; stroke: var(--accent-2); stroke-width: 2.4; stroke-dasharray: 10 6; }
</style>
