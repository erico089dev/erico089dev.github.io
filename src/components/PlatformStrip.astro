---
// Tira de iconos de plataforma/servicio. SVG inline autoalojado (sin peticiones externas).
// Uso: <PlatformStrip label="Publica en" items={["instagram","tiktok","youtube"]} />
interface Props {
  items: string[];
  label?: string;
  size?: 'md' | 'lg';
}

const { items, label, size = 'md' } = Astro.props;

const LABELS: Record<string, string> = {
  instagram: 'Instagram',
  tiktok: 'TikTok',
  youtube: 'YouTube Shorts',
  'google-calendar': 'Google Calendar',
  'google-tasks': 'Google Tasks',
  telegram: 'Telegram',
  claude: 'Claude',
  mic: 'Audio',
  ticket: 'Ticket',
};

const ICONS: Record<string, string> = {
  instagram: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#E1306C" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.8"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.05" fill="#E1306C" stroke="none"/></svg>`,
  tiktok: `<svg viewBox="0 0 24 24" width="20" height="20"><path d="M15.5 3.5c.3 1.9 1.6 3.2 3.5 3.4v2.4c-1.3 0-2.5-.4-3.5-1.1v5.9a5.1 5.1 0 1 1-5.1-5.1c.3 0 .6 0 .9.1v2.5a2.6 2.6 0 1 0 1.8 2.5V3.5h3.5Z" fill="#25F4EE" transform="translate(-1 1)"/><path d="M15.5 3.5c.3 1.9 1.6 3.2 3.5 3.4v2.4c-1.3 0-2.5-.4-3.5-1.1v5.9a5.1 5.1 0 1 1-5.1-5.1c.3 0 .6 0 .9.1v2.5a2.6 2.6 0 1 0 1.8 2.5V3.5h3.5Z" fill="#FE2C55" transform="translate(1 -1)"/><path d="M15.5 3.5c.3 1.9 1.6 3.2 3.5 3.4v2.4c-1.3 0-2.5-.4-3.5-1.1v5.9a5.1 5.1 0 1 1-5.1-5.1c.3 0 .6 0 .9.1v2.5a2.6 2.6 0 1 0 1.8 2.5V3.5h3.5Z" fill="currentColor"/></svg>`,
  youtube: `<svg viewBox="0 0 24 24" width="20" height="20"><rect x="2" y="5.5" width="20" height="13" rx="3.6" fill="#FF0000"/><path d="M10 9l5 3-5 3z" fill="#fff"/></svg>`,
  'google-calendar': `<svg viewBox="0 0 24 24" width="20" height="20"><rect x="4" y="5" width="16" height="15" rx="2.2" fill="#fff" stroke="#4285F4" stroke-width="1.5"/><rect x="4" y="5" width="16" height="4.2" rx="2.2" fill="#4285F4"/><text x="12" y="17.6" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#4285F4">31</text></svg>`,
  'google-tasks': `<svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="9" fill="#1A73E8"/><path d="M8 12.4l2.6 2.6 5-5.6" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  telegram: `<svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="10" fill="#29A9EA"/><path d="M17.6 7.4l-2.05 9.2c-.15.67-.56.83-1.14.52l-3.02-2.23-1.46 1.4c-.16.16-.3.3-.6.3l.21-3.02 5.5-4.97c.24-.21-.05-.33-.37-.12L7.4 12.4l-2.9-.9c-.63-.2-.64-.63.14-.94l11.3-4.35c.53-.2 1 .12.83.9Z" fill="#fff"/></svg>`,
  claude: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#D97757" stroke-width="2.3" stroke-linecap="round"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4"/></svg>`,
  mic: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M6 11a6 6 0 0 0 12 0M12 17v4"/></svg>`,
  ticket: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H6a2 2 0 0 1-2-2 2 2 0 0 0 0-4z"/><path d="M14 6.5v11" stroke-dasharray="2 2"/></svg>`,
};

const shown = items.filter((k) => ICONS[k]);
---

{shown.length > 0 && (
  <div class:list={['pstrip', size === 'lg' && 'pstrip--lg']}>
    {label && <span class="pstrip__label mono">{label}</span>}
    <ul class="pstrip__list">
      {shown.map((k) => (
        <li class="pchip" title={LABELS[k] ?? k} aria-label={LABELS[k] ?? k}>
          <Fragment set:html={ICONS[k]} />
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .pstrip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .pstrip__label {
    font-size: var(--step--1);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .pstrip__list {
    display: flex;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pchip {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    transition: transform 0.15s var(--ease), border-color 0.2s var(--ease);
  }
  .pchip:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }
  .pchip :global(svg) {
    display: block;
  }
  .pstrip--lg .pchip {
    width: 2.7rem;
    height: 2.7rem;
  }
  .pstrip--lg .pchip :global(svg) {
    width: 24px;
    height: 24px;
  }
</style>
