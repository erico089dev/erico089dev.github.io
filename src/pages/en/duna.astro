---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import Diagram from '../../components/Diagram.astro';
import DunaDiagram from '../../components/diagrams/DunaDiagram.astro';
import DunaDuneField from '../../components/DunaDuneField.astro';
import ConceptFlow from '../../components/ConceptFlow.astro';
import PhoneShot from '../../components/PhoneShot.astro';
import PhoneCarousel from '../../components/PhoneCarousel.astro';
import { getLocaleFromUrl, useTranslations, useRawTranslations } from '../../i18n/utils';

type Variant = 'ok' | 'standby' | 'private' | 'accent' | 'family';
interface BadgeItem { label: string; variant?: Variant }
interface Stat { value: string; label: string }
interface Feature { title: string; note: string; icon?: string; wide?: boolean }
interface Inside { label: string; note: string }
interface Shot { caption?: string; src?: string; alt?: string }
interface Stage { label: string; sub?: string; icon?: string; platforms?: string[] }
interface Disconnected { caption: string; calendarLabel: string; tasksLabel: string }

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const tRaw = useRawTranslations(locale);

const badges = tRaw<BadgeItem[]>('duna.badges', []);
const stats = tRaw<Stat[]>('duna.stats', []);
const needs = tRaw<string[]>('duna.problem.needs', []);
const problemShot = tRaw<Shot>('duna.problem.shot', { caption: '' });
const problemGallery = tRaw<Shot[]>('duna.problem.gallery', []);
const disconnected = tRaw<Disconnected>('duna.problem.disconnected', {
  caption: '',
  calendarLabel: 'Google Calendar',
  tasksLabel: 'Google Tasks',
});
const features = tRaw<Feature[]>('duna.features.items', []);
const inside = tRaw<Inside>('duna.features.inside', { label: '', note: '' });
const honestyShot = tRaw<Shot>('duna.honesty.shot', { caption: '' });
const concept = tRaw<Stage[]>('duna.concept.stages', []);

// Iconos inline (self-hosted) para las tarjetas de "Qué la hace especial".
const ICON: Record<string, string> = {
  lock: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><circle cx="12" cy="15.5" r="1.3"/></svg>`,
  bell: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 4 1.5 5.5 2 6H4c.5-.5 2-2 2-6Z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>`,
  sun: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="3.5"/><path d="M12 5.5V4M17 8l1-1M18.5 13H20M4 13h1.5M6 7 5 6M12 20.5a8.5 8.5 0 0 1 0 0"/><path d="M4.5 20.5h15"/></svg>`,
  clock: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>`,
};

// Iconos grandes de Google Calendar/Tasks para la ilustración de "apps separadas".
const GOOGLE_ICON: Record<string, string> = {
  calendar: `<svg viewBox="0 0 48 48" width="72" height="72"><rect x="4" y="6" width="40" height="38" rx="9" fill="#fff" stroke="#DADCE0" stroke-width="1"/><path d="M4 15a9 9 0 0 1 9-9h22a9 9 0 0 1 9 9v2H4z" fill="#4285F4"/><rect x="13" y="2" width="4.5" height="10" rx="2.2" fill="#4285F4"/><rect x="30.5" y="2" width="4.5" height="10" rx="2.2" fill="#4285F4"/><text x="24" y="35" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="17" font-weight="700" fill="#3C4043">23</text></svg>`,
  tasks: `<svg viewBox="0 0 48 48" width="72" height="72"><rect x="4" y="4" width="40" height="40" rx="13" fill="#1A73E8"/><circle cx="24" cy="24" r="13" fill="none" stroke="#fff" stroke-width="2.3"/><path d="M17.5 24.3l4.3 4.3 8.7-9.6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};
---

<Base title={t('duna.meta.title')} description={t('duna.meta.description')} family="duna">
  <div class="duna-page">
    <ProjectHero
      name={t('duna.name')}
      full={t('duna.full')}
      tagline={t('duna.tagline')}
      subLine={t('duna.heroLine')}
      badges={badges}
      backLabel={t('duna.back')}
      backHref={`/${locale}/#proyectos`}
      icon="/media/duna/icon.webp"
      iconAlt={t('duna.iconAlt')}
    >
      <DunaDuneField slot="bg" />
      <PhoneShot slot="visual" size="lg" caption={problemShot.caption} src={problemShot.src} alt={problemShot.alt} />
    </ProjectHero>

    <Section flush band="surface" eyebrow={t('duna.problem.eyebrow')} title={t('duna.problem.title')}>
      <div class="prob__grid">
        <div class="prob__text" data-reveal>
          <p class="prob__intro">{t('duna.problem.intro')}</p>
          <p class="prob__hook">{t('duna.problem.hook')}</p>
          <ul class="prob__needs">
            {needs.map((n) => <li class="prob__need">{n}</li>)}
          </ul>

          <div class="disc">
            <div class="disc__apps">
              <div class="disc__app">
                <span class="disc__halo disc__halo--cal" aria-hidden="true"></span>
                <span class="disc__ico" set:html={GOOGLE_ICON.calendar} />
                <span class="disc__name">{disconnected.calendarLabel}</span>
              </div>
              <span class="disc__gap" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19" /></svg>
              </span>
              <div class="disc__app">
                <span class="disc__halo disc__halo--tasks" aria-hidden="true"></span>
                <span class="disc__ico" set:html={GOOGLE_ICON.tasks} />
                <span class="disc__name">{disconnected.tasksLabel}</span>
              </div>
            </div>
            <p class="disc__caption">{disconnected.caption}</p>
          </div>
        </div>

        {
          problemGallery.length > 0 && (
            <div class="prob__gallery" data-reveal>
              <PhoneCarousel items={problemGallery} />
            </div>
          )
        }
      </div>

      <div class="solution" data-reveal>
        <p class="solution__label mono">{t('duna.problem.solution')}</p>
        <ConceptFlow stages={concept} />
      </div>
    </Section>

    <Section flush eyebrow={t('duna.arch.eyebrow')} title={t('duna.arch.title')}>
      <div class="arch" data-reveal>
        <Diagram
          title="Arquitectura Duna"
          caption={t('duna.arch.caption')}
          ariaLabel={t('duna.arch.diagramAlt')}
        >
          <DunaDiagram />
        </Diagram>
      </div>

      <h3 class="feat__lead" data-reveal>{t('duna.features.title')}</h3>
      <div class="feat-grid">
        {
          features.map((f) => (
            <article class:list={['feat', f.wide && 'feat--wide']} data-reveal>
              {f.icon && ICON[f.icon] && <span class="feat__ico" set:html={ICON[f.icon]} />}
              <div class="feat__body">
                <h4 class="feat__title">{f.title}</h4>
                <p class="feat__note">{f.note}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="feat__inside" data-reveal>
        <strong>{inside.label}</strong> — {inside.note}
      </p>
    </Section>

    <Section flush band="surface" eyebrow={t('duna.honesty.eyebrow')} title={t('duna.honesty.title')}>
      <div class="usage">
        <div class="usage__text" data-reveal>
          <p class="prose">{t('duna.honesty.body')}</p>
          {
            stats.length > 0 && (
              <div class="usage__facts">
                {stats.map((s) => (
                  <div class="fact">
                    <span class="fact__value">{s.value}</span>
                    <span class="fact__label">{s.label}</span>
                  </div>
                ))}
              </div>
            )
          }
        </div>
        <div class="usage__visual" data-reveal>
          <PhoneShot caption={honestyShot.caption} src={honestyShot.src} alt={honestyShot.alt} />
        </div>
      </div>
    </Section>

    <nav class="ddnav container" aria-label="Navegación entre proyectos">
      <a class="ddnav__link mono" href={`/${locale}/acg`}>{t('duna.nav.back')}</a>
      <a class="ddnav__link ddnav__next mono" href={`/${locale}/triagebox`}>{t('duna.nav.next')}</a>
    </nav>
  </div>
</Base>

<style>
  /* Solo esta página: más ancho útil, titulares más grandes, ritmo vertical más denso. */
  .duna-page {
    --maxw: 1360px;
    --pad-x: clamp(1rem, 0.6rem + 1.6vw, 1.75rem);
    --step-5: clamp(2.6rem, 2.1rem + 2.8vw, 3.4rem);
    --step-4: clamp(2.1rem, 1.7rem + 2vw, 2.7rem);
    --sp-6: 1.5rem;
    --sp-7: 2.25rem;
    --sp-8: 2.75rem;
    --sp-9: 3.5rem;
  }

  /* Hero: nombre/tagline/subtítulo mucho más grandes, captura de móvil más contenida
     para que el texto pese más que la imagen a su lado. */
  .duna-page :global(.phero__name) {
    font-size: clamp(3.6rem, 2.4rem + 6vw, 6rem);
  }
  .duna-page :global(.phero__tagline) {
    font-size: clamp(2rem, 1.5rem + 2.6vw, 2.9rem);
    max-width: 24ch;
  }
  .duna-page :global(.phero__subline) {
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.45rem);
    max-width: 40ch;
  }
  @media (min-width: 900px) {
    .duna-page :global(.phero__inner--split) {
      grid-template-columns: 1.3fr 0.7fr;
      gap: var(--sp-4);
    }
  }
  .duna-page :global(.phero__visual .pshot--lg) {
    max-width: 280px;
  }
  @media (min-width: 860px) {
    .duna-page :global(.phero__visual .pshot--lg) {
      max-width: 360px;
    }
  }

  .prose {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0;
  }

  /* El problema — en móvil el texto va primero; desde 860px el carrusel se coloca a
     la izquierda (order, sin tocar el DOM) para variar el patrón del hero, que lo
     lleva a la derecha. */
  .prob__grid {
    display: grid;
    gap: var(--sp-6);
    align-items: start;
  }
  @media (min-width: 860px) {
    .prob__grid {
      grid-template-columns: 0.55fr 1fr;
      gap: var(--sp-8);
    }
    .prob__gallery {
      order: -1;
    }
  }
  .prob__gallery {
    display: flex;
    justify-content: center;
  }
  .prob__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    max-width: 780px;
  }
  .prob__intro {
    font-size: var(--step-0);
    color: var(--text-muted);
    max-width: 44ch;
    margin: 0;
  }
  .prob__hook {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text);
    max-width: 20ch;
    margin: 0;
  }
  .prob__needs {
    display: grid;
    gap: var(--sp-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 520px) {
    .prob__needs { grid-template-columns: repeat(2, 1fr); }
  }
  .prob__need {
    position: relative;
    padding-left: 1.6rem;
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--text);
  }
  .prob__need::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--family);
    font-weight: 700;
  }

  /* Antes de Duna: Google Calendar y Google Tasks, cada una por su lado */
  .disc {
    padding: var(--sp-6) var(--sp-5);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-lg);
    background: var(--bg);
    text-align: center;
  }
  .disc__apps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-5);
  }
  .disc__app {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
  }
  .disc__halo {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    transform: translateX(-50%);
    filter: blur(20px);
    opacity: 0.55;
    animation: disc-pulse 5s ease-in-out infinite;
  }
  .disc__halo--cal { background: #4285f4; }
  .disc__halo--tasks { background: #1a73e8; animation-delay: -2.5s; }
  @keyframes disc-pulse {
    0%, 100% { opacity: 0.4; transform: translateX(-50%) scale(0.94); }
    50% { opacity: 0.65; transform: translateX(-50%) scale(1.08); }
  }
  .disc__ico {
    position: relative;
    display: grid;
    place-items: center;
  }
  .disc__name {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .disc__gap {
    display: grid;
    place-items: center;
    color: var(--text-muted);
    opacity: 0.5;
  }
  .disc__caption {
    margin-top: var(--sp-4);
    color: var(--text-muted);
    font-size: var(--step-0);
    max-width: 46ch;
    margin-inline: auto;
  }

  /* Así lo resuelve Duna: el flujo conceptual, cierra la sección del problema */
  .solution {
    margin-top: var(--sp-7);
    max-width: 560px;
    margin-inline: auto;
  }
  .solution__label {
    text-align: center;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--family);
    margin-bottom: var(--sp-4);
  }

  /* Cómo funciona + features */
  .arch { margin-bottom: var(--sp-7); }
  .feat__lead {
    font-size: var(--step-2);
    margin: 0 0 var(--sp-5);
  }
  .feat-grid {
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 720px) {
    .feat-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .feat {
    display: flex;
    gap: var(--sp-3);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .feat--wide {
    grid-column: 1 / -1;
    align-items: center;
    background:
      radial-gradient(90% 130% at 0% 0%, var(--family-soft), transparent 62%),
      var(--surface);
    border-color: color-mix(in srgb, var(--family) 30%, var(--border));
  }
  .feat__ico {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--r-md);
    color: var(--family);
    background: var(--family-soft);
  }
  .feat--wide .feat__ico {
    width: 3.1rem;
    height: 3.1rem;
  }
  .feat__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.2;
  }
  .feat--wide .feat__title { font-size: var(--step-2); }
  .feat__note {
    color: var(--text-muted);
    line-height: 1.5;
    margin-top: var(--sp-1);
  }
  .feat--wide .feat__note { font-size: var(--step-1); }
  .feat__inside {
    margin: var(--sp-5) 0 0;
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--r-md);
    background: var(--surface-2);
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .feat__inside strong {
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  /* En uso — texto + hechos / captura, alineados arriba */
  .usage {
    display: grid;
    gap: var(--sp-6);
  }
  @media (min-width: 860px) {
    .usage {
      grid-template-columns: 1fr 0.75fr;
      align-items: start;
      gap: var(--sp-8);
    }
  }
  .usage__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  .usage__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }
  @media (min-width: 480px) {
    .usage__facts { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 860px) {
    .usage__facts { grid-template-columns: repeat(2, 1fr); }
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .fact__value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--family);
    line-height: 1;
  }
  .fact__label {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .ddnav {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-8);
  }
  .ddnav__link {
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--text-muted);
  }
  .ddnav__link:hover { color: var(--family); }
  .ddnav__next { color: var(--family); }

  @media (prefers-reduced-motion: reduce) {
    .disc__halo { animation: none; }
  }
</style>
