---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ConceptFlow from '../../components/ConceptFlow.astro';
import Gallery from '../../components/Gallery.astro';
import { getLocaleFromUrl, useTranslations, useRawTranslations } from '../../i18n/utils';

type Variant = 'ok' | 'standby' | 'private' | 'accent' | 'family';
interface BadgeItem { label: string; variant?: Variant }
interface Highlight { title: string; note: string }
interface Shot { caption: string; src?: string }
interface Stage { label: string; sub?: string; icon?: string; platforms?: string[] }
interface Wip { title: string; body: string }

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const tRaw = useRawTranslations(locale);

const badges = tRaw<BadgeItem[]>('cumple.badges', []);
const wip = tRaw<Wip>('cumple.wip', { title: '', body: '' });
const highlights = tRaw<Highlight[]>('cumple.highlights.items', []);
const shots = tRaw<Shot[]>('cumple.gallery.items', []);
const concept = tRaw<Stage[]>('cumple.concept.stages', []);
---

<Base title={t('cumple.meta.title')} description={t('cumple.meta.description')} family="cumple">
  <ProjectHero
    name={t('cumple.name')}
    full={t('cumple.full')}
    tagline={t('cumple.tagline')}
    badges={badges}
    backLabel={t('cumple.back')}
    backHref={`/${locale}/#proyectos`}
  >
    <ConceptFlow slot="visual" stages={concept} />
  </ProjectHero>

  <div class="container">
    <div class="wip" data-reveal role="note">
      <svg class="wip__ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 16.5h.01" /><path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg>
      <div>
        <strong class="wip__title">{wip.title}</strong>
        <p class="wip__body">{wip.body}</p>
      </div>
    </div>
  </div>

  <Section flush band="surface" eyebrow={t('cumple.story.eyebrow')} title={t('cumple.story.title')}>
    <p class="prose" data-reveal>{t('cumple.story.body')}</p>
  </Section>

  <Section flush eyebrow={t('cumple.gallery.eyebrow')} title={t('cumple.gallery.title')}>
    <Gallery items={shots} />
  </Section>

  <Section flush band="surface" eyebrow={t('cumple.highlights.eyebrow')} title={t('cumple.highlights.title')}>
    <div class="hl-grid">
      {
        highlights.map((h) => (
          <article class="hl" data-reveal>
            <h3 class="hl__title">{h.title}</h3>
            <p class="hl__note">{h.note}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section flush eyebrow={t('cumple.honesty.eyebrow')} title={t('cumple.honesty.title')}>
    <p class="prose" data-reveal>{t('cumple.honesty.body')}</p>
  </Section>

  <nav class="ddnav container" aria-label="Navegación entre proyectos">
    <a class="ddnav__link mono" href={`/${locale}/triagebox`}>{t('cumple.nav.back')}</a>
    <a class="ddnav__link ddnav__next mono" href={`/${locale}/#proyectos`}>{t('cumple.nav.next')}</a>
  </nav>
</Base>

<style>
  .prose {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 68ch;
  }
  /* Aviso de página en construcción: color neutro (--standby), NO el de familia,
     para que se lea claramente como estado, no como parte del contenido. */
  .wip {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    margin-bottom: var(--sp-7);
    padding: var(--sp-4) var(--sp-5);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--standby) 8%, var(--surface));
    max-width: 68ch;
  }
  .wip__ico {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--standby);
  }
  .wip__title {
    display: block;
    font-size: var(--step-0);
    color: var(--text);
  }
  .wip__body {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .hl-grid {
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 720px) {
    .hl-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .hl {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-left: 3px solid var(--family);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .hl__title { font-size: var(--step-1); }
  .hl__note {
    color: var(--text-muted);
    max-width: none;
    line-height: 1.55;
  }
  .ddnav {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-8);
  }
  .ddnav__link {
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--text-muted);
  }
  .ddnav__link:hover { color: var(--family); }
  .ddnav__next { color: var(--family); }
</style>
