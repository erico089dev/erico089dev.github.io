---
import '../styles/global.css';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  family?: 'acg' | 'duna' | 'inbox';
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const { title = t('meta.title'), description = t('meta.description'), family } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// PNG, no SVG: LinkedIn y la mayoría de crawlers de redes sociales no renderizan SVG
// para la tarjeta de preview (og:image), así que hace falta un raster real.
const ogImage = Astro.site ? new URL('/og-image.png', Astro.site).href : undefined;

// hreflang: mismo path en cada idioma (funciona cuando existan las páginas EN/CA del paso 11).
const pathNoLocale = Astro.url.pathname.replace(/^\/(es|en|ca)(?=\/|$)/, '') || '/';
const localeMap: Record<string, string> = { es: 'es_ES', en: 'en_US', ca: 'ca_ES' };
const altLocales = ['es', 'en', 'ca'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Èric Casanovas Pérez',
  alternateName: 'Èric',
  jobTitle: 'AI Engineer · Full-stack',
  url: Astro.site?.href,
  email: 'mailto:casanovasecp89@gmail.com',
  sameAs: [
    'https://github.com/erico089dev',
    'https://www.linkedin.com/in/ericcasanovas',
  ],
};
---

<!doctype html>
<html lang={locale} data-family={family}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      Astro.site &&
        altLocales.map((l) => (
          <link
            rel="alternate"
            hreflang={l}
            href={new URL(`/${l}${pathNoLocale === '/' ? '/' : pathNoLocale}`, Astro.site).href}
          />
        ))
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Èric Casanovas Pérez" />
    <meta property="og:locale" content={localeMap[locale] ?? 'es_ES'} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Aplica el tema guardado antes de pintar (evita el flash).
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
        // Si la URL trae ancla (cambio de idioma / enlace directo a sección), oculta el
        // contenido hasta posicionar el scroll → no se ve el "sube y baja". Lo revela el
        // script del final del body (o una salvaguarda por timeout).
        if (location.hash && location.hash.length > 1) {
          document.documentElement.setAttribute('data-anchor-landing', '');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Nav locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />


    <script is:inline>
      // Aterrizaje en una sección por ancla (cambio de idioma). El contenido está oculto
      // (data-anchor-landing). En UNA sola pasada, tras cargar las fuentes (layout ya
      // estable, sin reflow), posiciona el scroll instantáneo y revela → aparece ya en la
      // sección, sin "sube y baja". Salvaguardas: timeout y cancelación si el usuario
      // interactúa (para no dejar nunca el contenido oculto).
      (function () {
        var root = document.documentElement;
        function reveal() { root.removeAttribute('data-anchor-landing'); }
        if (!location.hash || location.hash.length < 2) { reveal(); return; }
        var id = decodeURIComponent(location.hash.slice(1));
        var done = false;
        function finish() {
          if (done) return;
          done = true;
          var el = document.getElementById(id);
          if (el) {
            var y = el.getBoundingClientRect().top + (window.scrollY || window.pageYOffset || 0) - 80;
            window.scrollTo({ top: Math.max(0, y), behavior: 'auto' });
          }
          reveal();
        }
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (ev) {
          window.addEventListener(ev, function () { done = true; reveal(); }, { once: true, passive: true });
        });
        if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
          document.fonts.ready.then(function () { requestAnimationFrame(finish); });
        } else {
          requestAnimationFrame(finish);
        }
        setTimeout(finish, 700); // salvaguarda si fonts.ready no resuelve
      })();
    </script>

    <script is:inline>
      // Reveal on scroll (el CSS ya desactiva la animación con reduced-motion).
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
